{
  "name": "dosh-web",
  "private": true,
  "version": "0.1.8",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kube-dosh/dosh.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.e2e.json --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "bash ../scripts/run-playwright-container.sh",
    "e2e:chromium": "bash ../scripts/run-playwright-container.sh --project=chromium",
    "e2e:firefox": "bash ../scripts/run-playwright-container.sh --project=firefox",
    "e2e:webkit": "bash ../scripts/run-playwright-container.sh --project=webkit",
    "e2e:container": "bash ../scripts/run-playwright-container.sh",
    "e2e:oidc": "DOSH_PLAYWRIGHT_CONFIG=playwright.oidc.config.ts DOSH_PLAYWRIGHT_HOST_NETWORK=1 bash ../scripts/run-playwright-container.sh",
    "e2e:oidc:chromium": "DOSH_PLAYWRIGHT_CONFIG=playwright.oidc.config.ts DOSH_PLAYWRIGHT_HOST_NETWORK=1 bash ../scripts/run-playwright-container.sh --project=chromium",
    "e2e:local": "DOSH_PLAYWRIGHT_CONFIG=playwright.local.config.ts DOSH_PLAYWRIGHT_HOST_NETWORK=1 bash ../scripts/run-playwright-container.sh",
    "screenshots:readme": "DOSH_PLAYWRIGHT_CONFIG=playwright.screenshots.config.ts DOSH_PLAYWRIGHT_HOST_NETWORK=1 bash ../scripts/run-playwright-container.sh --project=chromium",
    "e2e:performance": "DOSH_PLAYWRIGHT_CONFIG=playwright.performance.config.ts bash ../scripts/run-playwright-container.sh --project=chromium-production",
    "e2e:typecheck": "tsc -p tsconfig.e2e.json --pretty false",
    "preview": "vite preview",
    "api:generate": "openapi-typescript ../api/openapi.yaml -o src/api/schema.d.ts",
    "api:check": "openapi-typescript ../api/openapi.yaml -o /tmp/dosh-schema-check.d.ts >/dev/null && cmp -s /tmp/dosh-schema-check.d.ts src/api/schema.d.ts",
    "bundle:check": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/view": "^6.43.15",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.105.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^8.21.3",
    "@uiw/react-codemirror": "^4.25.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "axe-core": "4.14.0",
    "jsdom": "^27.2.0",
    "msw": "^2.12.3",
    "openapi-typescript": "^7.10.1",
    "postcss": "^8.5.6",
    "tailwindcss": "3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.0.14"
  }
}
